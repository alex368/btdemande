{% extends 'base.html.twig' %}

{% block title %}Modifier le mot de passe{% endblock %}

{% block body %}
    <style>
        .profile-password-shell {
            max-width: 760px;
            margin: 0 auto;
            padding: 2.5rem 1rem 3rem;
        }

        .profile-password-hero {
            background: linear-gradient(130deg, #173f9a 0%, #214995 55%, #2f6ed6 100%);
            color: #fff;
            padding: 1.6rem;
            box-shadow: 0 16px 34px rgba(23, 63, 154, 0.24);
            margin-bottom: 1rem;
        }

        .profile-password-card {
            border: 1px solid #e6ecf8;
            background: #fff;
            box-shadow: 0 10px 24px rgba(33, 73, 149, 0.08);
            padding: 1.4rem;
        }

        .profile-password-card .form-label {
            color: #214995;
            font-weight: 700;
            font-size: 0.78rem;
            letter-spacing: 0.07em;
            text-transform: uppercase;
        }

        .profile-password-card .form-control {
            border-radius: 0;
            border-color: #d8e3f7;
            min-height: 46px;
        }
    </style>

    <main class="p-4 d-flex justify-content-center" style="min-height: 100vh; overflow-y: auto;">
        <div class="profile-password-shell">
            <header class="profile-password-hero">
                <h1 class="h4 mb-1 text-uppercase fw-bold">Modifier le mot de passe</h1>
                <p class="mb-0 opacity-75">Saisis ton mot de passe actuel puis ton nouveau mot de passe.</p>
            </header>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} alert-dismissible fade show rounded-0" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            <section class="profile-password-card">
                {{ form_start(form, {'action': path('app_profile_password', { id: profileUser.id })}) }}
                    <div class="mb-3">
                        {{ form_label(form.currentPassword) }}
                        {{ form_widget(form.currentPassword, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.currentPassword) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.newPassword.first) }}
                        {{ form_widget(form.newPassword.first, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.newPassword.first) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.newPassword.second) }}
                        {{ form_widget(form.newPassword.second, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.newPassword.second) }}
                    </div>

                    <div class="d-flex gap-2">
                        <a href="{{ path('app_profile', { id: profileUser.id }) }}" class="btn btn-outline-secondary rounded-0">Retour</a>
                        <button type="submit" class="btn btn-primary rounded-0">Enregistrer le nouveau mot de passe</button>
                    </div>
                {{ form_end(form) }}
            </section>
        </div>
    </main>
{% endblock %}
