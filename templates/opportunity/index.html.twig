{% extends 'base.html.twig' %}

{% block title %}Nouvelle Opportunité{% endblock %}

{% block body %}
<div class="container mt-4">

    <h1 class="mb-4">Ajouter une Opportunité pour {{ contact.firstName }} {{ contact.lastName }}</h1>

    <div class="card">
        <div class="card-body">

            {{ form_start(form) }}

                {{ form_row(form.leadSource) }}
                {{ form_row(form.leadSourceDetail) }}
                {{ form_row(form.commercialReferent) }}
                {{ form_row(form.createdAt) }}

                <button class="btn btn-primary mt-3">Enregistrer</button>

                <a href="{{ path('app_contact_show', { id: contact.id }) }}"
                   class="btn btn-secondary mt-3">
                    Retour au contact
                </a>

            {{ form_end(form) }}

        </div>
    </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const sourceSelect = document.querySelector('.js-lead-source');
    const detailRow = document.querySelector('.js-lead-source-detail-row');
    if (!sourceSelect || !detailRow) return;

    const refreshVisibility = () => {
        const isReferral = sourceSelect.value === 'recommandation_partenaire';
        detailRow.classList.toggle('d-none', !isReferral);
    };

    refreshVisibility();
    sourceSelect.addEventListener('change', refreshVisibility);
});
</script>
{% endblock %}
