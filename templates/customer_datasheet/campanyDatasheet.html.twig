{% extends 'base.html.twig' %}

{% block title %}Hello CustomerDatasheetController!
{% endblock %}

{% block body %}
	{% set isPhysicalPerson = campanies.legalType == 'personne_physique' %}
	{% set legalBadgeLabel = isPhysicalPerson ? 'PP' : 'PM' %}
	{% set legalBadgeTitle = isPhysicalPerson ? 'Personne physique' : 'Personne morale' %}


	<!-- Contenu principal à droite -->
	<main
		class="col-md-12 col-lg-12 p-2">
		<!-- Contenu principal à gauche -->

		<h1 class="form-label text-center bebas text-color-blue mb-5 mt-5">FICHE ENTREPRISE</h1>


		<div class="container ">
			<div class="text-end mb-3">
				<a href="{{path('app_funding_request',{id:campanies.id, user:user})}}" class="btn btn-warning rounded-0">
					Nouvelle demande
				</a>
				<a href="{{path('app_chat_customer',{id:campanies.id, user:user})}}" class="btn btn-warning rounded-0">
					Lucy Folder
				</a>
			</div>

			<nav aria-label="breadcrumb">
				<ol class="breadcrumb">
					<li class="breadcrumb-item">
						<a href="{{path('app_customer_datasheet',{id:user})}}">Entreprise</a>
					</li>
					<li class="breadcrumb-item active" aria-current="page">Fiche</li>
				</ol>
			</nav>



			{# {% for user in campanies.customer %}
						{{ dump(user.id) }}
						{% endfor %} #}

			<div class="card shadow-sm rounded-0 border-0 p-4 text-center" style="max-width: 1200px;">
				<a href="{{path('app_campany_edit',{id:campanies.id})}}"
				     class="btn btn-roadmap fw-bold px-5 py-2 shadow-sm rounded-0 position-absolute top-0 end-0 m-3"
				     style="background-color:#FBBB3B; color:#fff;">
				    Modifier
				  </a>  

				<!-- Logo -->
					<div class="mb-3 text-center"> <img src="{{ asset('uploads/logos/' ~ campanies.logo) }}" alt="Logo Entreprise" width="90" class="company-logo rounded bg-white">
				</div>


				<!-- Nom -->
				<div class="d-flex justify-content-center align-items-center gap-2 mb-4">
					<h5 class="fw-bold mb-0">{{ campanies.legalName }}</h5>
					<span
						class="badge rounded-pill px-3 py-2"
						style="background-color: {{ isPhysicalPerson ? '#6B7280' : '#214995' }}; color: #fff;"
						title="{{ legalBadgeTitle }}"
					>
						<i class="bi {{ isPhysicalPerson ? 'bi-person' : 'bi-building' }} me-1"></i>{{ legalBadgeLabel }}
					</span>
				</div>

				<!-- Infos entreprise -->
				<table class="table company-info border">
					<tbody>
						<tr>
							<td class="fw-bold">Type :</td>
							<td>{{ legalBadgeTitle }}</td>
						</tr>
						<tr>
							<td class="fw-bold">SIREN :</td>
							<td>{{campanies.siren}}</td>
						</tr>
						<tr>
							<td class="fw-bold">Secteur :</td>
							<td>{{campanies.sector}}</td>
						</tr>
						<tr>
							<td class="fw-bold">Forme juridique :</td>
							<td>Bientôt</td>
						</tr>
						<tr>
							<td class="fw-bold">Date de création :</td>
							<td>{{ campanies.creationDate|date('d/m/Y') }}</td>
						</tr>
						<tr>
							<td class="fw-bold">Capital social :</td>
							<td>bientôt</td>
						</tr>
					</tbody>
				</table>

				<!-- Bouton -->
				<div class="mt-3">
					<a href="{{ path('app_roadmap',{id:campanies.id, user:user})}}" class="btn btn-roadmap fw-bold px-5 py-2 shadow-sm rounded-0" style="background-color:#FBBB3B; color:#fff;">
						Roadmap
					</a>
				</div>
			</div>


			<div class="card shadow-sm rounded-0 border-0 mt-5">
				<div class="card-header bg-white fw-bold">
					Historique de financement
				</div>
				<div class="table-responsive">
						<table class="table  align-middle mb-0">
						<thead class="table-primary text-white">

							<tr>
								<th>Produit</th>
								<th>Montant</th>
								<th>status</th>
								<th>Suppression</th>
								<th>Action</th>
							</tr>

						</thead>

						<tbody>

							{% for requestDemand in requestDemands %}
								{% set pendingDelete = pendingDeletionByRequestId[requestDemand.id]|default(false) %}
								<tr>
									<td>{{requestDemand.product.name}}</td>
									<td>{{ requestDemand.amount|number_format(0, ',', ' ') }}&nbsp;€</td>
									<td>{{requestDemand.status}}</td>
									<td>
										{% if pendingDelete %}
											<span class="badge bg-warning text-dark">Validation admin en attente</span>
										{% else %}
											<span class="badge bg-secondary">Aucune demande</span>
										{% endif %}
									</td>
									<td class="text-center">
										{% if pendingDelete %}
											<button type="button" class="btn btn-outline-secondary btn-sm" disabled title="Demande en attente">
												<i class="bi bi-trash"></i>
											</button>
										{% else %}
											<button
												type="button"
												class="btn btn-outline-danger btn-sm btn-request-delete"
												title="Demander la suppression"
												data-bs-toggle="modal"
												data-bs-target="#deleteRequestModal"
												data-request-id="{{ requestDemand.id }}"
											>
												<i class="bi bi-trash"></i>
											</button>
										{% endif %}
										<a href="{{path('app_document_index',{id:requestDemand.id, user:user})}}" class="btn btn-outline-primary btn-sm ms-1" title="Voir">
											<i class="bi bi-chevron-right"></i>
										</a>
									</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="5" class="text-center text-muted">Aucun dossier</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
		</div>

		<div class="modal fade" id="deleteRequestModal" tabindex="-1" aria-labelledby="deleteRequestModalLabel" aria-hidden="true">
			<div class="modal-dialog">
				<div class="modal-content rounded-0">
					<form method="post" action="{{ path('app_campany_deletion_request', {id: campanies.id, user: user}) }}" id="deleteRequestForm">
						<div class="modal-header">
							<h5 class="modal-title" id="deleteRequestModalLabel">Demander une suppression (validation admin obligatoire)</h5>
							<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
						</div>
						<div class="modal-body">
							<input type="hidden" name="_token" value="{{ csrf_token('campany-deletion-request-' ~ campanies.id) }}">
							<div id="deleteRequestIdsContainer"></div>
							<div class="mb-2">
								<label class="form-label fw-semibold">Motif (optionnel)</label>
								<textarea name="reason" class="form-control" rows="3" placeholder="Motif (optionnel)"></textarea>
							</div>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal">Retour</button>
							<button type="submit" class="btn btn-danger rounded-0">Envoyer la demande de suppression</button>
						</div>
					</form>
				</div>
			</div>
		</div>


	</main>
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			const modalEl = document.getElementById('deleteRequestModal');
			const idsContainer = document.getElementById('deleteRequestIdsContainer');
			if (!modalEl || !idsContainer) {
				return;
			}

			modalEl.addEventListener('show.bs.modal', function (event) {
				idsContainer.innerHTML = '';

				const trigger = event.relatedTarget;
				const singleRequestId = trigger ? trigger.getAttribute('data-request-id') : null;

				if (singleRequestId) {
					const input = document.createElement('input');
					input.type = 'hidden';
					input.name = 'funding_request_ids[]';
					input.value = singleRequestId;
					idsContainer.appendChild(input);
				}
			});
		});
	</script>
{% endblock %}
