{% extends 'base.html.twig' %}

{% block title %}Hello CustomerPortalController!
{% endblock %}

{% block body %}
	<body>
		<!-- Contenu principal à droite -->
		<main class="col-md-12 col-lg-12 p-2">
			<!-- Contenu principal à gauche -->



			<h1 class="form-label text-center bebas text-color-blue mb-5 mt-5">Portail client</h1>


			<div class="container ">

				<div class="d-flex justify-content-center">
					<form method="get" class="mb-4">
						<div class="input-group mx-auto" style="max-width: 800px;">
							<span class="input-group-text bg-white border-end-0">
								<i class="bi bi-search text-muted"></i>
							</span>
							<input type="text" name="search" class="form-control border-start-0" placeholder="Search..." value="{{ search }}">
						</div>
					</form>
				</div>


				<div class="card shadow-sm rounded-0 border-0 mt-5">
					<div class="card-header bg-white fw-bold">
						Clients
					</div>
					<div class="table-responsive">
						<table class="table  align-middle mb-0">
							<thead class="table-primary text-white">
								<tr>
									<th>Nom</th>
									<th>Prénom</th>
									<th>Numéro</th>
									<th>Référent</th>
									<th>Détail</th>
								</tr>
							</thead>

							<tbody>

							<pre>
								
							</pre>
								{% for customer in pagination %}
									<tr>
										<td>{{ customer.lastname }}</td>
										<td>{{ customer.name }}</td>
										<td>{{ customer.number }}</td>
										<td>
											{% if customer.referent %}
												{{ customer.referent.lastname }} {{ customer.referent.name }}
											{% else %}
												-
											{% endif %}
										</td>
										<td class="text-end">
												<a href="{{ path('app_customer_datasheet', { id: customer.id }) }}" class="text-decoration-none">
													<i class="bi bi-chevron-right"></i>
												</a>
											</td>
										{# {% for customer in campany.customer %}
										{{ campany.legalName }}
											<td>{{ customer.name }}</td>
											<td>{{ customer.lastname }}</td>
											<td>{{ customer.number }}</td>
											<td class="text-end">
												<a href="{{ path('app_customer_datasheet', { id: customer.id }) }}" class="text-decoration-none">
													<i class="bi bi-chevron-right"></i>
												</a>
											</td>
										{% endfor %} #}


									</tr>
								{% endfor %}
							</tbody>
						</table>
						{{ knp_pagination_render(pagination) }}</div>
				</body>
			</div>
		</div>
	</body>
</main></body></div></div></body>{% endblock %}
