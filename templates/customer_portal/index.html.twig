{% extends 'base.html.twig' %}

{% block title %}Portail client{% endblock %}

{% block body %}
<main class="col-md-12 col-lg-12 p-2">
    <h1 class="form-label text-center bebas text-color-blue mb-5 mt-5">Portail client</h1>

    <div class="container">
        <style>
            .customer-portal-table thead a {
                color: #fff !important;
                text-decoration: none;
            }

            .customer-portal-table thead a:hover {
                text-decoration: underline;
            }

            .customer-portal-sort-indicator {
                margin-left: 0.3rem;
                font-size: 0.82rem;
                opacity: 0.95;
            }

            .customer-portal-sort-indicator.is-inactive {
                opacity: 0.45;
            }
        </style>

        {% set currentSort = app.request.query.get('sort') %}
        {% set currentDirection = app.request.query.get('direction')|default('asc')|lower %}

        <form method="get" class="mb-4">
            <div class="row g-2">
                <div class="col-md-4">
                    <input
                        type="text"
                        name="search"
                        class="form-control"
                        placeholder="Recherche globale"
                        value="{{ search }}"
                    >
                </div>
                <div class="col-md-3">
                    <input
                        type="text"
                        name="campany"
                        class="form-control"
                        placeholder="Filtrer par entreprise"
                        value="{{ campany }}"
                    >
                </div>
                <div class="col-md-3">
                    <input
                        type="text"
                        name="project"
                        class="form-control"
                        placeholder="Filtrer par projet"
                        value="{{ project }}"
                    >
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary rounded-0">Filtrer</button>
                </div>
            </div>
        </form>

        <div class="card shadow-sm rounded-0 border-0 mt-4">
            <div class="card-header bg-white fw-bold">Clients</div>
            <div class="table-responsive">
                <table class="table align-middle mb-0 customer-portal-table">
                    <thead class="table-primary text-white">
                        <tr>
                            <th>
                                {{ knp_pagination_sortable(pagination, 'Nom', 'u.lastname') }}
                                <span class="customer-portal-sort-indicator {{ currentSort == 'u.lastname' ? '' : 'is-inactive' }}">
                                    {{ currentSort == 'u.lastname' ? (currentDirection == 'asc' ? '↑' : '↓') : '↕' }}
                                </span>
                            </th>
                            <th>
                                {{ knp_pagination_sortable(pagination, 'Prénom', 'u.name') }}
                                <span class="customer-portal-sort-indicator {{ currentSort == 'u.name' ? '' : 'is-inactive' }}">
                                    {{ currentSort == 'u.name' ? (currentDirection == 'asc' ? '↑' : '↓') : '↕' }}
                                </span>
                            </th>
                            <th>
                                {{ knp_pagination_sortable(pagination, 'Référent', 'r.lastname') }}
                                <span class="customer-portal-sort-indicator {{ currentSort == 'r.lastname' ? '' : 'is-inactive' }}">
                                    {{ currentSort == 'r.lastname' ? (currentDirection == 'asc' ? '↑' : '↓') : '↕' }}
                                </span>
                            </th>
                            <th>
                                {{ knp_pagination_sortable(pagination, 'Entreprise', 'c.legalName') }}
                                <span class="customer-portal-sort-indicator {{ currentSort == 'c.legalName' ? '' : 'is-inactive' }}">
                                    {{ currentSort == 'c.legalName' ? (currentDirection == 'asc' ? '↑' : '↓') : '↕' }}
                                </span>
                            </th>
                            <th>
                                {{ knp_pagination_sortable(pagination, 'Projet', 'c.projetName') }}
                                <span class="customer-portal-sort-indicator {{ currentSort == 'c.projetName' ? '' : 'is-inactive' }}">
                                    {{ currentSort == 'c.projetName' ? (currentDirection == 'asc' ? '↑' : '↓') : '↕' }}
                                </span>
                            </th>
                            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_COLLABORATOR') %}
                                <th>
                                    {{ knp_pagination_sortable(pagination, 'Affectation', 'r.lastname') }}
                                    <span class="customer-portal-sort-indicator {{ currentSort == 'r.lastname' ? '' : 'is-inactive' }}">
                                        {{ currentSort == 'r.lastname' ? (currentDirection == 'asc' ? '↑' : '↓') : '↕' }}
                                    </span>
                                </th>
                            {% endif %}
                            <th>Détail</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for customer in pagination %}
                            <tr>
                                <td>{{ customer.lastname }}</td>
                                <td>{{ customer.name }}</td>
                                <td>
                                    {% if customer.referent %}
                                        {{ customer.referent.lastname }} {{ customer.referent.name }}
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td>
                                    {% if customer.campanies|length > 0 %}
                                        {% for campanyItem in customer.campanies %}
                                            {{ campanyItem.legalName }}{% if not loop.last %}, {% endif %}
                                        {% endfor %}
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td>
                                    {% if customer.campanies|length > 0 %}
                                        {% for campanyItem in customer.campanies %}
                                            {{ campanyItem.projetName ?: '-' }}{% if not loop.last %}, {% endif %}
                                        {% endfor %}
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_COLLABORATOR') %}
                                    <td>
                                        <form method="post" action="{{ path('app_customer_portal_assign_referent', { id: customer.id }) }}" class="d-flex gap-2 align-items-center">
                                            <input type="hidden" name="_token" value="{{ csrf_token('assign-referent-' ~ customer.id) }}">
                                            <select name="referent_id" class="form-select form-select-sm">
                                                <option value="">Aucun</option>
                                                {% for referent in referents %}
                                                    <option value="{{ referent.id }}" {% if customer.referent and customer.referent.id == referent.id %}selected{% endif %}>
                                                        {{ referent.lastname }} {{ referent.name }}
                                                    </option>
                                                {% endfor %}
                                            </select>
                                            <button class="btn btn-sm btn-warning rounded-0" type="submit">OK</button>
                                        </form>
                                    </td>
                                {% endif %}
                                <td class="text-end">
                                    <a href="{{ path('app_customer_datasheet', { id: customer.id }) }}" class="text-decoration-none">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="{{ (is_granted('ROLE_ADMIN') or is_granted('ROLE_COLLABORATOR')) ? 7 : 6 }}" class="text-center py-4 text-muted">Aucun client trouvé.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-3">
            {{ knp_pagination_render(pagination) }}
        </div>
    </div>
</main>
{% endblock %}
