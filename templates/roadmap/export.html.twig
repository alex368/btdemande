<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Roadmap Financière</title>
    <style>
        body {
            margin: 0;
            padding: 28px 32px 36px;
            font-family: DejaVu Sans, sans-serif;
            font-size: 12px;
            line-height: 1.55;
            color: #20365f;
            background: #ffffff;
        }

        .report-header {
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 2px solid #d9e2f3;
        }

        .report-kicker {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            color: #6d7f9f;
            margin-bottom: 8px;
        }

        .report-title {
            margin: 0 0 6px;
            font-size: 26px;
            line-height: 1.2;
            color: #16346c;
        }

        .report-subtitle {
            margin: 0;
            color: #4e6288;
        }

        .report-summary {
            margin-bottom: 24px;
            color: #4e6288;
        }

        .step-card {
            border: 1px solid #dbe4f3;
            padding: 18px 20px;
            margin-bottom: 18px;
            page-break-inside: avoid;
        }

        .step-heading {
            margin-bottom: 10px;
        }

        .step-label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            color: #7a8dac;
            margin-bottom: 6px;
        }

        .step-title {
            margin: 0;
            font-size: 20px;
            line-height: 1.3;
            color: #16346c;
        }

        .step-meta {
            margin: 2px 0 0;
            font-size: 12px;
            color: #4e6288;
        }

        .step-description {
            margin: 14px 0 16px;
            color: #40557d;
        }

        .details-table {
            width: 100%;
            border-collapse: collapse;
        }

        .details-table th {
            width: 33.33%;
            text-align: left;
            padding: 10px 12px;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            color: #6f82a4;
            background: #f5f8fd;
            border: 1px solid #dbe4f3;
        }

        .details-table td {
            padding: 12px;
            font-size: 13px;
            font-weight: bold;
            color: #20365f;
            border: 1px solid #dbe4f3;
            vertical-align: top;
        }
    </style>
</head>
<body>
    <header class="report-header">
        <div class="report-kicker">Roadmap financière</div>
        <h1 class="report-title">
            {% if campany is defined %}
                {{ campany.legalName }}
            {% else %}
                Rapport de financement
            {% endif %}
        </h1>
        <p class="report-subtitle">
            Ce rapport présente les étapes de financement prévues, leur temporalité et les informations utiles à leur compréhension.
        </p>
    </header>

    <section class="report-summary">
        Chaque étape indique le dispositif concerné, le trimestre de mobilisation, la date cible, le montant estimatif et le type de dépense associé.
    </section>

    {% for r in roadmaps %}
        {% set roadmap = r.entity %}
        <article class="step-card">
            <div class="step-heading">
                <div class="step-label">Étape {{ loop.index }}</div>
                <h2 class="step-title">
                    {{ roadmap.product ? roadmap.product.name : 'Dispositif non défini' }}
                </h2>
                <p class="step-meta">
                    {{ roadmap.date|date('Y') }} {{ r.quarter }}{% if roadmap.date is not null %} | {{ roadmap.date|date('d/m/Y') }}{% endif %}
                </p>
            </div>

            <table class="details-table">
                <thead>
                    <tr>
                        <th>Date cible</th>
                        <th>Montant estimatif</th>
                        <th>Type de dépense</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{{ roadmap.date ? roadmap.date|date('d/m/Y') : 'Non renseignée' }}</td>
                        <td>
                            {% if roadmap.estimatedAmount is not null %}
                                {{ roadmap.estimatedAmount|number_format(0, ',', ' ') }} €
                            {% else %}
                                Non renseigné
                            {% endif %}
                        </td>
                        <td>{{ roadmap.expenseType ?: 'Non renseigné' }}</td>
                    </tr>
                </tbody>
            </table>
        </article>
    {% endfor %}
</body>
</html>
