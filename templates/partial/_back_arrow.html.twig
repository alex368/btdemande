{% if app.request.hasPreviousSession and app.session.get('nav.previous_uri') %}
    <style>
        .session-back-arrow {
            position: fixed;
            top: 1.1rem;
            left: 256px;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #214995;
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            box-shadow: 0 8px 24px rgba(17, 40, 80, 0.18);
            z-index: 1090;
            transition: transform 0.15s ease, background-color 0.15s ease;
        }

        .session-back-arrow:hover,
        .session-back-arrow:focus-visible {
            background: #173f9a;
            color: #fff;
            transform: translateX(-2px);
            outline: none;
        }

        @media (max-width: 768px) {
            .session-back-arrow {
                left: 12px;
                top: 12px;
            }
        }
    </style>

    <a href="{{ path('app_back') }}" class="session-back-arrow" aria-label="Retour à la page précédente" title="Retour">
        <i class="bi bi-arrow-left"></i>
    </a>
{% endif %}

