{% extends 'base.html.twig' %}

{% block title %}Créer un contact{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Créer un contact</h1>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            {{ form_start(form) }}

            {# ------- IDENTITÉ -------- #}
            <h5 class="fw-bold mb-3"><i class="bi bi-person-badge"></i> Identité</h5>

            <div class="row">
                <div class="col-md-4">
                    {{ form_row(form.salutation) }}
                </div>
                <div class="col-md-4">
                    {{ form_row(form.lastName) }}
                </div>
                <div class="col-md-4">
                    {{ form_row(form.firstName) }}
                </div>
            </div>

            <hr>

            {# ------- EMAILS -------- #}
            <h5 class="fw-bold mt-3"><i class="bi bi-envelope"></i> E-mails</h5>

            <div id="email-wrapper"
                 data-prototype="{{ form_widget(form.email.vars.prototype)|e('html_attr') }}"
                 data-index="{{ form.email|length }}">

                {% for emailField in form.email %}
                    <div class="d-flex gap-2 mb-2">
                        {{ form_widget(emailField) }}
                        <button type="button" class="btn btn-danger btn-sm remove-item">X</button>
                    </div>
                {% endfor %}

            </div>

            <button type="button" class="btn btn-primary btn-sm mt-2" id="add-email">
                <i class="bi bi-plus-circle"></i> Ajouter un email
            </button>

            <hr>

            {# ------- TELEPHONES / MOBILES -------- #}
            <div class="row mt-4">

                <div class="col-md-6">
                    <h5 class="fw-bold"><i class="bi bi-telephone"></i> Téléphones fixes</h5>

                    <div id="phone-wrapper"
                         data-prototype="{{ form_widget(form.phone.vars.prototype)|e('html_attr') }}"
                         data-index="{{ form.phone|length }}">

                        {% for phoneField in form.phone %}
                            <div class="d-flex gap-2 mb-2">
                                {{ form_widget(phoneField) }}
                                <button type="button" class="btn btn-danger btn-sm remove-item">X</button>
                            </div>
                        {% endfor %}
                    </div>

                    <button type="button" class="btn btn-primary btn-sm mt-2" id="add-phone">
                        <i class="bi bi-plus-circle"></i> Ajouter un numéro
                    </button>
                </div>

                <div class="col-md-6">
                    <h5 class="fw-bold"><i class="bi bi-phone"></i> Mobiles</h5>

                    <div id="mobile-wrapper"
                         data-prototype="{{ form_widget(form.mobilePhone.vars.prototype)|e('html_attr') }}"
                         data-index="{{ form.mobilePhone|length }}">

                        {% for mobileField in form.mobilePhone %}
                            <div class="d-flex gap-2 mb-2">
                                {{ form_widget(mobileField) }}
                                <button type="button" class="btn btn-danger btn-sm remove-item">X</button>
                            </div>
                        {% endfor %}
                    </div>

                    <button type="button" class="btn btn-primary btn-sm mt-2" id="add-mobile">
                        <i class="bi bi-plus-circle"></i> Ajouter un mobile
                    </button>
                </div>
            </div>

            <hr>

            {# ------- RÉSEAUX SOCIAUX -------- #}
            <h5 class="fw-bold mt-4"><i class="bi bi-share"></i> Réseaux sociaux</h5>

            <div id="social-wrapper"
                 data-prototype="{{ form_widget(form.socialMedia.vars.prototype)|e('html_attr') }}"
                 data-index="{{ form.socialMedia|length }}">

                {% for socialField in form.socialMedia %}
                    <div class="d-flex gap-2 mb-2">
                        {{ form_widget(socialField) }}
                        <button type="button" class="btn btn-danger btn-sm remove-item">X</button>
                    </div>
                {% endfor %}
            </div>

            <button type="button" class="btn btn-primary btn-sm mt-2" id="add-social">
                <i class="bi bi-plus-circle"></i> Ajouter un réseau social
            </button>

            <hr>

            {# ------- ADRESSE -------- #}
            <h5 class="fw-bold mt-4"><i class="bi bi-geo-alt"></i> Adresse</h5>

            <div class="row">
                <div class="col-md-4">
                    {{ form_row(form.country) }}
                </div>
                <div class="col-md-4">
                    {{ form_row(form.city) }}
                </div>
                <div class="col-md-4">
                    {{ form_row(form.adress) }}
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-6">
                    {{ form_row(form.zipCode) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.website) }}
                </div>
            </div>

            <hr>

            {# ------- PROFESSION ------- #}
            <h5 class="fw-bold mt-4"><i class="bi bi-briefcase"></i> Profession & Entreprise</h5>

            <div class="row">
                <div class="col-md-6">
                    {{ form_row(form.occupation) }}
                </div>
            </div>

            <div class="mt-3">
                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#companyModal">
                    <i class="bi bi-building"></i> Créer une entreprise (optionnel)
                </button>
            </div>

            <div class="d-none">
                {{ form_widget(form.createCompany, {'attr': {'id': 'create-company-flag'}}) }}
            </div>

            <div class="modal fade" id="companyModal" tabindex="-1" aria-labelledby="companyModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="companyModalLabel">Entreprise (optionnel)</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-md-6">{{ form_row(form.companyLegalName) }}</div>
                                <div class="col-md-6">{{ form_row(form.companyProjectName) }}</div>
                            </div>
                            <div class="row">
                                <div class="col-md-4">{{ form_row(form.companySiren) }}</div>
                                <div class="col-md-4">{{ form_row(form.companySector) }}</div>
                                <div class="col-md-4">{{ form_row(form.companyStage) }}</div>
                            </div>
                            <div class="row">
                                <div class="col-md-8">{{ form_row(form.companyAddress) }}</div>
                                <div class="col-md-4">{{ form_row(form.companyCreationDate) }}</div>
                            </div>
                            <hr>
                            <div class="form-check">
                                {{ form_widget(form.createAccount, {'attr': {'class': 'form-check-input', 'id': 'create-account-flag'}}) }}
                                {{ form_label(form.createAccount, 'Créer aussi un compte client (optionnel)', {'label_attr': {'class': 'form-check-label', 'for': 'create-account-flag'}}) }}
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" id="clear-company-data">Retirer l’entreprise</button>
                            <button type="button" class="btn btn-primary" id="save-company-modal" data-bs-dismiss="modal">Valider</button>
                        </div>
                    </div>
                </div>
            </div>

            <button class="btn btn-success mt-4 px-4">
                <i class="bi bi-check2-circle"></i> Créer le contact
            </button>

            {{ form_end(form) }}

        </div>
    </div>
</div>

{# ---------------------------- JS COLLECTIONS ----------------------------- #}
<script>
function addItem(wrapperId) {
    const wrapper = document.getElementById(wrapperId);
    const prototype = wrapper.dataset.prototype;
    const index = wrapper.dataset.index;

    const newForm = prototype.replace(/__name__/g, index);
    wrapper.dataset.index = parseInt(index) + 1;

    const div = document.createElement('div');
    div.classList.add('d-flex', 'gap-2', 'mb-2');
    div.innerHTML = newForm + '<button type="button" class="btn btn-danger btn-sm remove-item">X</button>';

    wrapper.appendChild(div);
}

document.getElementById('add-email').addEventListener('click', () => addItem('email-wrapper'));
document.getElementById('add-phone').addEventListener('click', () => addItem('phone-wrapper'));
document.getElementById('add-mobile').addEventListener('click', () => addItem('mobile-wrapper'));
document.getElementById('add-social').addEventListener('click', () => addItem('social-wrapper'));

document.addEventListener('click', (e) => {
    if (e.target.classList.contains('remove-item')) {
        e.target.parentNode.remove();
    }
});

const companyFlag = document.getElementById('create-company-flag');
const saveCompanyModal = document.getElementById('save-company-modal');
const clearCompanyData = document.getElementById('clear-company-data');
const companyInputs = [
    document.getElementById('{{ form.companyLegalName.vars.id }}'),
    document.getElementById('{{ form.companyProjectName.vars.id }}'),
    document.getElementById('{{ form.companySiren.vars.id }}'),
    document.getElementById('{{ form.companySector.vars.id }}'),
    document.getElementById('{{ form.companyStage.vars.id }}'),
    document.getElementById('{{ form.companyAddress.vars.id }}'),
    document.getElementById('{{ form.companyCreationDate.vars.id }}')
];

const companyHasData = () => companyInputs.some((el) => el && String(el.value || '').trim() !== '');

if (saveCompanyModal && companyFlag) {
    saveCompanyModal.addEventListener('click', () => {
        companyFlag.checked = companyHasData();
    });
}

if (clearCompanyData && companyFlag) {
    clearCompanyData.addEventListener('click', () => {
        companyInputs.forEach((el) => {
            if (!el) return;
            if (el.tagName === 'SELECT') {
                el.selectedIndex = 0;
            } else {
                el.value = '';
            }
        });
        companyFlag.checked = false;
    });
}
</script>

{% endblock %}
