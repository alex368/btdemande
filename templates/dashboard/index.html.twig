{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<main class="col-md-12 col-lg-12 p-2">
    <div class="container">
        <div class="row g-3 align-items-stretch">
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card border-0 shadow p-3 text-center h-100">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <i class="bi-credit-card-fill icon-blue"></i>
                        <i class="bi bi-three-dots-vertical"></i>
                    </div>
                    <div class="amount text-color-yellow bebas">{{ totalAccorde|number_format(0, ',', ' ') }}&nbsp;€</div>
                    <div class="text-color-yellow mt-2 bebas bold">Accordé</div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card border-0 shadow p-3 text-center h-100">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <i class="bi bi-pie-chart-fill icon-blue"></i>
                        <i class="bi bi-three-dots-vertical"></i>
                    </div>
                    <div class="amount text-color-yellow bebas">{{ subventionTotal|number_format(0, ',', ' ') }}&nbsp;€</div>
                    <div class="text-color-blue mt-2 bebas">Subvention</div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card border-0 shadow p-3 text-center h-100">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <i class="bi bi-cart-fill icon-blue"></i>
                        <i class="bi bi-three-dots-vertical"></i>
                    </div>
                    <div class="amount text-color-yellow bebas">{{ pretTotal|number_format(0, ',', ' ') }}&nbsp;€</div>
                    <div class="text-color-blue mt-2 bebas">Prêt</div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card border-0 shadow p-3 text-center h-100">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <i class="bi bi-piggy-bank-fill icon-blue"></i>
                        <i class="bi bi-three-dots-vertical"></i>
                    </div>
                    <div class="amount text-color-yellow bebas">{{ pretHonneurTotal|number_format(0, ',', ' ') }}&nbsp;€</div>
                    <div class="text-color-blue mt-2 bebas">Prêt d'honneur</div>
                </div>
            </div>
        </div>
    </div>

    <div class="container mt-4">
        <div class="row g-4">
            <div class="col-12 col-lg-4">
                <div class="card p-4 shadow border-0 h-100">
                    <h5 class="text-start text-color-blue mb-2">BTD Actus</h5>
                    <div id="carouselExampleDark" class="carousel carousel-dark slide" data-bs-ride="carousel">
                        <div class="carousel-indicators">
                            <button type="button" data-bs-target="#carouselExampleDark" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                            <button type="button" data-bs-target="#carouselExampleDark" data-bs-slide-to="1" aria-label="Slide 2"></button>
                            <button type="button" data-bs-target="#carouselExampleDark" data-bs-slide-to="2" aria-label="Slide 3"></button>
                        </div>
                        <div class="carousel-inner">
                            <div class="carousel-item active" data-bs-interval="10000">
                                <img src="https://www.btdconsulting.fr/wp-content/uploads/go-x/u/3f719f41-a8b7-4e0f-aaa3-bf015a0d9fd5/l0,t14,w474,h238/image.webp" class="d-block w-100" alt="Actu 1">
                            </div>
                            <div class="carousel-item" data-bs-interval="2000">
                                <img src="https://www.btdconsulting.fr/wp-content/uploads/go-x/u/23335c42-99a0-4681-912c-7de526f60d92/l80,t0,w314,h197/image.webp" class="d-block w-100" alt="Actu 2">
                            </div>
                            <div class="carousel-item">
                                <img src="https://www.btdconsulting.fr/wp-content/uploads/go-x/u/009894c3-0b26-40c7-8043-cef3f7c80e1b/l0,t29,w474,h298/image.webp" class="d-block w-100" alt="Actu 3">
                            </div>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleDark" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleDark" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="card p-3 shadow border-0 h-100">
                    <h5 class="text-start mb-3 text-color-blue">Dossiers en cours</h5>
                    <div style="height: 300px;" class="d-flex justify-content-center align-items-center">
                        <canvas id="ongoingPieChart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="card p-3 shadow border-0 h-100">
                    <h5 class="text-start mb-3 text-color-blue">Dossiers validés de l'année</h5>
                    <div style="height: 300px;" class="d-flex justify-content-center align-items-center">
                        <canvas id="validatedPieChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container mt-4">
        <div class="row g-4 align-items-stretch">
            {% for request in dashboardRequests|slice(0, 3) %}
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card border-0 shadow p-3 text-center h-100">
                        <div class="d-flex align-items-start text-center mb-2">
                            <img src="{{ asset('uploads/logos/' ~ request.product.fundingMechanism.logo) }}" alt="Logo" width="40" class="me-2">
                        </div>
                        <div class="text-center">{{ request.product.name }}</div>
                        <div>
                            <span class="badge badge-custom fw-bold">{{ request.displayStatus }}</span>
                        </div>
                        <p class="mb-2">Etat d’avancement</p>
                        {% set progressIndex = request.trackingProgressIndex %}
                        {% set totalSteps = trackingStatuses|length %}
                        {% set percent = progressIndex >= 0 ? ((progressIndex + 1) / totalSteps * 100)|round(0, 'floor') : 0 %}
                        <div class="card border-0 p-2 mb-3 text-start" style="background-color: #214995;">
                            <div class="text-white small mb-2">Étape actuelle: {{ request.displayStatus }}</div>
                            <div class="progress mb-2" style="height: 8px;">
                                <div
                                    class="progress-bar"
                                    role="progressbar"
                                    style="width: {{ percent }}%; background-color:#FBBB3B;"
                                    aria-valuenow="{{ percent }}"
                                    aria-valuemin="0"
                                    aria-valuemax="100"
                                ></div>
                            </div>
                            <div class="d-flex justify-content-between text-white-50 small">
                                <span>Début</span>
                                <span>{{ percent }}%</span>
                                <span>Clôture</span>
                            </div>
                        </div>

                        {% if request.status == statusWaitingClient %}
                            <a class="btn btn-custom w-100" href="{{ path('client_documents', { id: request.id }) }}">Faire ma demande</a>
                        {% elseif request.status == statusBackFromClient %}
                            <a class="btn btn-custom w-100" href="{{ path('client_request_tracking', { id: request.id }) }}">Suivre ma demande</a>
                        {% else %}
                            <a class="btn btn-custom w-100" href="{{ path('client_request_tracking', { id: request.id }) }}">Voir</a>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}

            <div class="col-12 col-md-6 col-lg-3">
                <div class="card border-0 shadow p-3 h-100 text-start">
                    <div class="d-flex justify-content-between text-color-blue mb-2">
                        <span class="small">Dossier</span>
                        <a href="{{ path('app_customer_folder') }}" class="small fw-semibold text-decoration-none">Voir tout</a>
                    </div>
                    {% if dashboardRequests|length > 0 %}
                        {% for request in dashboardRequests|slice(0, 5) %}
                            <div class="d-flex justify-content-between mb-2">
                                <div>
                                    <img src="{{ asset('uploads/logos/' ~ request.product.fundingMechanism.logo) }}" alt="Logo" width="40" class="me-2">
                                    {{ request.product.name }}
                                </div>
                                <div>
                                    <strong>{{ request.amount|default(0) }}€</strong>
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="text-muted">Aucune donnée disponible</div>
                    {% endif %}
                </div>
            </div>
        </div>

        {% if dashboardRequests|length > 3 %}
            <div class="text-center mt-3">
                <a href="{{ path('app_customer_folder') }}" class="btn btn-outline-primary">Voir plus</a>
            </div>
        {% endif %}
    </div>

    <div class="container mt-4 mb-4">
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow p-3 h-100 text-start">
                    <div class="d-flex justify-content-between text-color-blue mb-3">
                        <span class="small">Événements du jour</span>
                        <a href="{{ path('app_event_index') }}" class="small fw-semibold text-decoration-none">Voir tout</a>
                    </div>
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3">
                        {% if events is not empty %}
                            {% for event in events|slice(0, 4) %}
                                <div class="col">
                                    <div class="border rounded p-3 h-100">
                                        <div class="fw-semibold text-color-blue mb-2">{{ event.title }}</div>
                                        <div class="small text-muted">
                                            {{ event.startDate|date('d/m/Y H:i') }}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="col-12 text-muted small">Aucun événement aujourd’hui</div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
const ongoingFinanceurs = {{ ongoingFinanceurData|json_encode|raw }};
const validatedFinanceurs = {{ validatedFinanceurData|json_encode|raw }};

const backgroundColors = [
    '#FBBB3B',
    '#272E80',
    '#038B92',
    '#038BC2',
    '#E7226F',
    '#6F42C1',
    '#198754',
    '#0EA5E9'
];

function renderPieChart(canvasId, dataset, emptyLabel) {
    const canvas = document.getElementById(canvasId);
    if (!canvas) {
        return;
    }

    const labels = Object.keys(dataset);
    const values = Object.values(dataset);

    new Chart(canvas.getContext('2d'), {
        type: 'pie',
        data: {
            labels: labels.length ? labels : [emptyLabel],
            datasets: [{
                data: values.length ? values : [1],
                backgroundColor: labels.length ? backgroundColors.slice(0, labels.length) : ['#D1D5DB']
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'right',
                    labels: {
                        usePointStyle: true,
                        pointStyle: 'circle'
                    }
                },
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            if (!labels.length) {
                                return emptyLabel;
                            }
                            return context.label + ' : ' + context.raw + ' dossier(s)';
                        }
                    }
                }
            }
        }
    });
}

renderPieChart('ongoingPieChart', ongoingFinanceurs, 'Aucun dossier en cours');
renderPieChart('validatedPieChart', validatedFinanceurs, 'Aucun dossier validé');
});
</script>
{% endblock %}
