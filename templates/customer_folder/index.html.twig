{% extends 'base.html.twig' %}

{% block title %}Mes dossiers{% endblock %}

{% block body %}
<main class="col-md-12 col-lg-12 p-2">
    <h1 class="form-label text-center bebas text-color-blue mb-5 mt-5">Mes dossiers</h1>

    <div class="container">
        <div class="card shadow-sm rounded-0 border-0 mt-5">
            <div class="card-header bg-white fw-bold">
                Mes dossiers
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-primary text-white">
                        <tr>
                            <th>Entreprise</th>
                            <th>Montant</th>
                            <th>Produit</th>
                            <th>Statut</th>
                            <th>Avancement</th>
                            <th>Détail</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for find in findRequests %}
                            <tr>
                                <td>{{ find.campany ? find.campany.legalName : '—' }}</td>
                                <td>{{ find.amount|default(0)|number_format(0, ',', ' ') }} €</td>
                                <td>{{ find.product ? find.product.name : '—' }}</td>
                                <td>{{ find.displayStatus }}</td>
                                <td>
                                    {% set progressIndex = find.trackingProgressIndex %}
                                    {% set totalSteps = trackingStatuses|length %}
                                    {% set percent = progressIndex >= 0 ? ((progressIndex + 1) / totalSteps * 100)|round(0, 'floor') : 0 %}
                                    <div class="progress" style="height: 8px;">
                                        <div
                                            class="progress-bar"
                                            role="progressbar"
                                            style="width: {{ percent }}%; background-color:#1E3A8A;"
                                            aria-valuenow="{{ percent }}"
                                            aria-valuemin="0"
                                            aria-valuemax="100"
                                        ></div>
                                    </div>
                                    <small class="text-muted">{{ percent }}%</small>
                                </td>
                                <td class="text-center">
                                    <a href="{{ path('app_document_index', { id: find.id, user: find.user.id }) }}" class="bi bi-chevron-right"></a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-muted text-center">Aucun dossier trouvé</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if findRequests.getTotalItemCount is defined and findRequests.getTotalItemCount > 0 %}
                <div class="card-footer bg-white">
                    {{ knp_pagination_render(findRequests) }}
                </div>
            {% endif %}
        </div>
    </div>
</main>
{% endblock %}
