{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block sidebar '' %}

{% block body %}
{% include 'partial/_back_arrow.html.twig' %}
<div class="container-fluid">
    <div class="row h-100">
        <div class="col-md-6 mb-5 d-flex flex-column justify-content-center px-8">
            <div class="text-center my-3">
                <img src="{{ asset('image/logo.png') }}" alt="Logo" width="80">
            </div>

            <h1 class="form-label text-center bebas mb-4 text-color-blue">Inscription</h1>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} alert-dismissible fade show rounded-0" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {{ form_start(form, {'attr': {'data-turbo': 'false'}}) }}

            <div class="card border-0 shadow-sm rounded-0 p-4 bg-white">
                <div class="mb-3">
                    {{ form_label(form.name, null, {'label_attr': {'class': 'form-label fw-bold bebas'}}) }}
                    {{ form_widget(form.name) }}
                    {{ form_errors(form.name) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.lastname, null, {'label_attr': {'class': 'form-label fw-bold bebas'}}) }}
                    {{ form_widget(form.lastname) }}
                    {{ form_errors(form.lastname) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.email, null, {'label_attr': {'class': 'form-label fw-bold bebas'}}) }}
                    {{ form_widget(form.email) }}
                    {{ form_errors(form.email) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.number, null, {'label_attr': {'class': 'form-label fw-bold bebas'}}) }}
                    {{ form_widget(form.number) }}
                    {{ form_errors(form.number) }}
                </div>

                <div class="mb-0">
                    {{ form_label(form.password, null, {'label_attr': {'class': 'form-label fw-bold bebas'}}) }}
                    <div class="password-field-wrap shadow">
                        {{ form_widget(form.password, {'attr': {'id': 'register-password', 'class': 'form-control border-0 py-3 px-4 fs-5'}}) }}
                        <button
                            type="button"
                            class="password-eye-toggle"
                            id="register-password-toggle"
                            aria-label="Afficher le mot de passe"
                            onclick="togglePasswordField('register-password', 'register-password-toggle')"
                        >
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    {{ form_errors(form.password) }}
                </div>
            </div>

            <div class="d-grid gap-3 mt-4">
                <button class="btn btn-lg bebas button-custom rounded-0 py-3 px-4 fs-5" type="submit" style="color: #FFF;">
                    Créer mon compte
                </button>
                <a href="{{ path('app_login') }}" class="text-center bebas fs-5 text-decoration-none text-color-blue">
                    Déjà inscrit ? Se connecter
                </a>
            </div>

            {{ form_end(form) }}
        </div>

        <div class="col-md-6 d-none d-md-block"
             style="background-image: url('{{ asset('image/register.png') }}'); background-size: cover; background-position: center; background-repeat: no-repeat; height: 100%;">
        </div>
    </div>
</div>

<script>
function togglePasswordField(inputId, buttonId) {
    const input = document.getElementById(inputId);
    const button = document.getElementById(buttonId);
    if (!input || !button) return;

    const isPassword = input.type === 'password';
    input.type = isPassword ? 'text' : 'password';
    button.innerHTML = isPassword ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
    button.setAttribute('aria-label', isPassword ? 'Masquer le mot de passe' : 'Afficher le mot de passe');
}
</script>
{% endblock %}
