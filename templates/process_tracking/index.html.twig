{% extends 'base.html.twig' %}

{% block title %}Suivi des dossiers{% endblock %}

{% block body %}
<main class="col-md-12 col-lg-12 p-2">
	<h1 class="form-label text-center bebas text-color-blue mb-5 mt-5">Suivi des dossiers</h1>

	<div class="container text-center mt-2">
		<div class="row g-4 align-items-stretch">
			{% for tracking in trackingData %}
				{% set campany = tracking.campany %}
				{% set requests = tracking.requests %}
				{% set mainRequest = requests|first %}

				<div class="col-12 col-md-6 col-lg-3">
					<div class="card border-0 shadow p-3 text-center h-100">
						{% if mainRequest and mainRequest.product and mainRequest.product.fundingMechanism %}
							<img src="{{ asset('uploads/logos/' ~ mainRequest.product.fundingMechanism.logo )}}" alt="Logo" width="40" class="me-2">
						{% endif %}

						<div class="text-center fw-bold">{{ campany.legalName }}</div>
						{% if mainRequest %}
							<div>
								<span class="badge badge-custom fw-bold">{{ mainRequest.displayStatus }}</span>
							</div>
						{% endif %}
						<p class="mb-2">État d’avancement</p>
						{% if mainRequest %}
							{% set progressIndex = mainRequest.trackingProgressIndex %}
							{% set totalSteps = trackingStatuses|length %}
							{% set percent = progressIndex >= 0 ? ((progressIndex + 1) / totalSteps * 100)|round(0, 'floor') : 0 %}
						{% else %}
							{% set percent = 0 %}
						{% endif %}
						<div class="card border-0 p-2 mb-3 text-start" style="background-color: #214995;">
							<div class="text-white small mb-2">
								Étape actuelle: {{ mainRequest ? mainRequest.displayStatus : '—' }}
							</div>
							<div class="progress mb-2" style="height: 8px;">
								<div
									class="progress-bar"
									role="progressbar"
									style="width: {{ percent }}%; background-color:#FBBB3B;"
									aria-valuenow="{{ percent }}"
									aria-valuemin="0"
									aria-valuemax="100"
								></div>
							</div>
							<div class="d-flex justify-content-between text-white-50 small">
								<span>Début</span>
								<span>{{ percent }}%</span>
								<span>Clôture</span>
							</div>
						</div>

						{% if mainRequest and mainRequest.status == waitingClientStatus %}
							<a class="btn btn-custom w-100" href="{{ path('client_documents', { id: mainRequest.id }) }}">
								Faire ma demande
							</a>
						{% elseif mainRequest and mainRequest.status in trackingStatuses %}
							<a class="btn btn-custom w-100" href="{{ path('client_request_tracking', { id: mainRequest.id }) }}">
								Suivre ma demande
							</a>
						{% endif %}
					</div>
				</div>
			{% else %}
				<div class="col-12 text-muted">Aucun dossier à suivre.</div>
			{% endfor %}
		</div>
	</div>
</main>
{% endblock %}
