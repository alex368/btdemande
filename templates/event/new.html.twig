{% extends 'base.html.twig' %}

{% block title %}Ajouter un événement{% endblock %}

{% block body %}

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <h1 class="card-title mb-4 text-center">
                {{ event is defined ? 'Modifier un événement' : 'Nouvel événement' }}
            </h1>

            {{ form_start(form) }}
                {{ form_errors(form) }}

                {{ form_row(form.title, { attr: {
                    'data-slug-target':'title'
                } }) }}
{{ form_row(form.slug, { attr: {
  'data-slug-target':'slug',
  'readonly': 'readonly',
  'class': (form.slug.vars.attr.class|default('') ~ ' form-control bg-light text-muted')|trim,
  'style': 'cursor:not-allowed; opacity:0.85;'
} }) }}



                {{ form_row(form.theme) }}

                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.startDate) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.endDate) }}
                    </div>
                </div>

                {{ form_row(form.url) }}
                {{ form_row(form.description) }}

                <div class="d-flex justify-content-between mt-4">
                    <a href="{{ path('app_event_index') }}" class="btn btn-outline-secondary">← Retour</a>
                    <button class="btn btn-primary">
                        {{ event is defined ? 'Modifier un événement' : 'Créer un événement' }}
                    </button>
                </div>

            {{ form_end(form) }}

        </div>
    </div>

    <script>

document.addEventListener('DOMContentLoaded', () => {
  const start = document.querySelector('[name$="[startDate]"]');
  const end   = document.querySelector('[name$="[endDate]"]');
  if (!start || !end) return;

  function sync() {
    if (start.value) end.min = start.value;   // end >= start
    else end.removeAttribute('min');

    if (end.value) start.max = end.value;     // start <= end
    else start.removeAttribute('max');
  }

  start.addEventListener('change', sync);
  end.addEventListener('change', sync);
  sync();
});

      (function () {
        const titleEl = document.querySelector('[data-slug-target="title"]');
        const slugEl  = document.querySelector('[data-slug-target="slug"]');

        if (!titleEl || !slugEl) return;

        let slugTouched = slugEl.value.trim().length > 0;

        slugEl.addEventListener('input', () => {
          slugTouched = slugEl.value.trim().length > 0;
        });

        const toSlug = (s) => {
          return (s || '')
            .toString()
            .toLowerCase()
            .trim()
            .normalize('NFD').replace(/[\u0300-\u036f]/g, '')  // enlève accents
            .replace(/[^a-z0-9]+/g, '-')                      // espaces -> -
            .replace(/^-+|-+$/g, '');                         // trim -
        };

        titleEl.addEventListener('input', () => {
          if (slugTouched) return;
          const v = toSlug(titleEl.value);
          if (v !== '') slugEl.value = v;
        });
      })();
    </script>

{% endblock %}
