{% extends 'base.html.twig' %}

{% block title %}Réinitialisation{% endblock %}

{% block sidebar '' %}

{% block body %}
    <div class="container-fluid">
    <div class="row h-100">
        <div class="col-md-6 mb-5 d-flex flex-column justify-content-center px-8">
            <div class="text-center my-3">
                <img src="{{ asset('image/logo.png') }}" alt="Logo" width="80">
            </div>

            <h1 class="form-label text-center bebas mb-3" style="color:#FBBB3B;">Réinitialiser le mot de passe</h1>
            <p class="text-center mb-4">
                Saisis ton email pour recevoir le lien de réinitialisation.
            </p>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} alert-dismissible fade show rounded-0" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            <form method="post" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="inputEmail" class="form-label fw-bold bebas">Email</label>
                    <input
                        type="email"
                        id="inputEmail"
                        class="form-control border-0 rounded-0 shadow py-3 px-4 fs-5"
                        name="email"
                        placeholder="Entrez votre email"
                        autocomplete="email"
                        required
                    />
                    <div class="invalid-feedback">Veuillez entrer un email valide.</div>
                </div>

                <div class="d-grid gap-3 mt-4">
                    <button type="submit" class="btn btn-lg bebas button-custom rounded-0 py-3 px-4 fs-5" style="color:#FFF;">
                        Envoyer le lien
                    </button>
                    <a href="{{ path('app_login') }}" class="text-center bebas fs-5 text-decoration-none" style="color:#214995;">
                        Retour à la connexion
                    </a>
                </div>
            </form>
        </div>

        <div class="col-md-6 d-none d-md-block"
             style="background-image: url('{{ asset('image/imageLogin.png') }}'); background-size: cover; background-position: center; background-repeat: no-repeat; height: 100%;">
        </div>
    </div>
</div>
{% endblock %}
