{% extends 'base.html.twig' %}

{% block title %}
    Hello FundingRequestController!
{% endblock %}

{% block body %}

    <!-- Contenu principal à droite -->
    <main class="col-md-12 col-lg-12 p-2">
        <div class="container mt-5">
            <h1 class="mb-4">
                Nouvelle demande de financement
            </h1>

            	<nav aria-label="breadcrumb">
				<ol class="breadcrumb">
					{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_COLLABORATOR') %}
						<li class="breadcrumb-item">
							<a href="{{ path('app_campany',{id:campany.id, user})}}">Entreprise</a>
							
						</li>
						{% elseif is_granted('ROLE_CUSTOMER') %}
						<li class="breadcrumb-item">
							<a href="#">Demande</a>
						</li>
					{% endif %}
					<li class="breadcrumb-item active" aria-current="page">Financement</li>
				</ol>
			</nav>

            {% for message in app.flashes('success') %}
                <div class="alert alert-success">
                    {{ message }}
                </div>
            {% endfor %}

            {{ form_start(form) }}

            {{ form_row(form.amount) }}
            {{ form_row(form.product) }}
            {{ form_row(form.user) }}
            {{ form_row(form.assistant) }}

            <button type="submit" class="btn btn-primary mt-3">
                <i class="bi bi-check-circle me-1"></i>
                Soumettre la demande
            </button>

            {{ form_end(form) }}
        </div>
    </main>
{% endblock %}
