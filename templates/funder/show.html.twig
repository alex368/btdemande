{% extends 'base.html.twig' %}

{% block title %}Funder Details{% endblock %}

{% block body %}
<div class="container mt-4">


    <h1 class="mb-4">Funder Details</h1>

    <div class="card">
        <div class="card-body">

            <table class="table table-bordered">
                <tr>
                    <th>Name</th>
                    <td>{{ funders.name }}</td>
                </tr>

                <tr>
                    <th>Sector</th>
                    <td>{{ funders.sector }}</td>
                </tr>

                <tr>
                    <th>Type</th>
                    <td>{{ funders.type }}</td>
                </tr>

                <tr>
                    <th>Pays</th>
                    <td>{{ funders.country ?: '-' }}</td>
                </tr>

                <tr>
                    <th>Région</th>
                    <td>{{ funders.region ?: '-' }}</td>
                </tr>

                <tr>
                    <th>Ville</th>
                    <td>{{ funders.city ?: '-' }}</td>
                </tr>

                <tr>
                    <th>Code postal</th>
                    <td>{{ funders.postalCode ?: '-' }}</td>
                </tr>

                <tr>
                    <th>Adresse</th>
                    <td>{{ funders.address ?: '-' }}</td>
                </tr>

                <tr>
                    <th>Type de projet</th>
                    <td>{{ funders.projectType ?: '-' }}</td>
                </tr>

                <tr>
                    <th>Description</th>
                 <td>{{ funders.description|raw }}</td>

                </tr>

                <tr>
                    <th>Logo</th>
                    <td>
                        {% if funders.logo %}
                            <img src="/uploads/logos/{{ funders.logo }}" 
                                 alt="Logo" 
                                 class="img-fluid" 
                                 style="max-width: 180px; max-height: 120px; object-fit: contain; background:#fff;">
                        {% else %}
                            <em>Aucun logo téléversé.</em>
                        {% endif %}
                    </td>
                </tr>
            </table>

            <div class="d-flex gap-2 mt-3">

                <a href="{{ path('app_funder') }}" class="btn btn-secondary">Retour</a>
                            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_COLLABORATOR') %}
                <a href="{{ path('app_funder_edit', { id: funders.id }) }}" class="btn btn-warning">Modifier</a>

                <form method="post"
                      action="{{ path('app_funder_delete', { id: funders.id }) }}"
                      onsubmit="return confirm('Voulez-vous vraiment supprimer ce financeur ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ funders.id) }}">
                    <button class="btn btn-danger">Supprimer</button>
                </form>
                {% endif %}
            </div>

        </div>
    </div>

</div>
{% endblock %}
